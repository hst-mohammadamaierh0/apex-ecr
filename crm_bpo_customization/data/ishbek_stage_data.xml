<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sales_team_ishbek" model="crm.team">
            <field name="name">ISHBEK Sales Team</field>
            <field name="use_leads">True</field>
            <field name="use_opportunities">True</field>
            <field name="sequence">20</field>
        </record>

        <record id="stage_ish_1" model="crm.stage">
            <field name="name">Opportunity</field>
            <field name="sequence">101</field>
            <field name="team_id" ref="sales_team_ishbek"/>
        </record>

        <record id="stage_ish_2" model="crm.stage">
            <field name="name">DEMO / TECHNICAL DISCOVERY</field>
            <field name="sequence">102</field>
            <field name="team_id" ref="sales_team_ishbek"/>
        </record>

        <record id="stage_ish_3" model="crm.stage">
            <field name="name">Send Proposal</field>
            <field name="sequence">103</field>
            <field name="team_id" ref="sales_team_ishbek"/>
        </record>

        <record id="stage_ish_4" model="crm.stage">
            <field name="name">Client Confirmation</field>
            <field name="sequence">104</field>
            <field name="team_id" ref="sales_team_ishbek"/>
        </record>

        <record id="stage_ish_5" model="crm.stage">
            <field name="name">ONBOARDING – INTEGRATIONS</field>
            <field name="sequence">105</field>
            <field name="team_id" ref="sales_team_ishbek"/>
        </record>

        <record id="stage_ish_6" model="crm.stage">
            <field name="name">ONBOARDING – MENU SETUP</field>
            <field name="sequence">106</field>
            <field name="team_id" ref="sales_team_ishbek"/>
        </record>

        <record id="stage_ish_7" model="crm.stage">
            <field name="name">GO LIVE</field>
            <field name="sequence">107</field>
            <field name="team_id" ref="sales_team_ishbek"/>
        </record>

        <record id="stage_ish_8" model="crm.stage">
            <field name="name">SEND INVOICE</field>
            <field name="sequence">108</field>
            <field name="is_won">True</field>
            <field name="team_id" ref="sales_team_ishbek"/>
        </record>

        <record id="stage_ish_9" model="crm.stage">
            <field name="name">LOST</field>
            <field name="sequence">109</field>
            <field name="is_won">False</field>
            <field name="fold">True</field>
            <field name="team_id" ref="sales_team_ishbek"/>
        </record>
    </data>
</odoo>