<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rule_helpdesk_team_visibility_final" model="ir.rule">
            <field name="name">Helpdesk Team: Portal Mirror Visibility</field>
            <field name="model_id" ref="helpdesk.model_helpdesk_team"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">
                ['|', '|',
                    ('department_id', 'in', user.employee_id.department_id.accessible_department_ids.ids),
                    ('department_id', '=', False),
                    (user.has_group('helpdesk.group_helpdesk_manager'), '=', True)
                ]
            </field>
        </record>

        <record id="rule_helpdesk_ticket_portal_mirror" model="ir.rule">
            <field name="name">Helpdesk Ticket: Portal Mirror Visibility</field>
            <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">
                ['|', '|',
                    ('create_uid', '=', user.id),
                    ('department_id', '=', user.employee_id.department_id.id),
                    (user.has_group('helpdesk.group_helpdesk_manager'), '=', True)
                ]
            </field>
        </record>
    </data>
</odoo>